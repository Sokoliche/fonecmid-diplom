<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Расход запланированных отпусков</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сотрудник</dataPath>
			<field>Сотрудник</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоДнейПоПлану</dataPath>
			<field>КоличествоДнейПоПлану</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество дней по плану</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоДнейОтгулено</dataPath>
			<field>КоличествоДнейОтгулено</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество дней отгулено</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВКМ_ДниОтпускаСотрудников.Сотрудник КАК Сотрудник,
	ВКМ_ДниОтпускаСотрудников.КоличествоДней КАК КоличествоДней
ПОМЕСТИТЬ ВременнаяТаблица
ИЗ
	РегистрНакопления.ВКМ_ДниОтпускаСотрудников КАК ВКМ_ДниОтпускаСотрудников
ГДЕ
	ВКМ_ДниОтпускаСотрудников.ДатаНачала &gt;= &amp;ДатаНачала
	И ВКМ_ДниОтпускаСотрудников.ДатаОкончания &lt;= &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВременнаяТаблица.Сотрудник КАК Сотрудник,
	ВременнаяТаблица.КоличествоДней КАК КоличествоДнейПоПлану,
	ВЫБОР
		КОГДА ВременнаяТаблица.КоличествоДней - ВКМ_ДниОтпускаСотрудников.КоличествоДней = 0
			ТОГДА ВременнаяТаблица.КоличествоДней
		ИНАЧЕ ВЫБОР
				КОГДА РАЗНОСТЬДАТ(ВКМ_ДниОтпускаСотрудников.ДатаОкончания, &amp;ДатаОкончания, ДЕНЬ) &gt; ВременнаяТаблица.КоличествоДней
					ТОГДА ВременнаяТаблица.КоличествоДней
				ИНАЧЕ РАЗНОСТЬДАТ(ВКМ_ДниОтпускаСотрудников.ДатаОкончания, &amp;ДатаОкончания, ДЕНЬ)
			КОНЕЦ
	КОНЕЦ КАК КоличествоДнейОтгулено
ИЗ
	ВременнаяТаблица КАК ВременнаяТаблица
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВКМ_ДниОтпускаСотрудников КАК ВКМ_ДниОтпускаСотрудников
		ПО ВременнаяТаблица.Сотрудник = ВКМ_ДниОтпускаСотрудников.Сотрудник
ГДЕ
	ВКМ_ДниОтпускаСотрудников.ДатаНачала &gt;= &amp;ДатаНачала
	И ВКМ_ДниОтпускаСотрудников.ДатаОкончания &lt;= &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ВременнаяТаблица.Сотрудник,
	ВременнаяТаблица.КоличествоДней,
	ВЫБОР
		КОГДА ВременнаяТаблица.КоличествоДней - ВКМ_ДниОтпускаСотрудников.КоличествоДней = 0
			ТОГДА ВременнаяТаблица.КоличествоДней
		ИНАЧЕ ВЫБОР
				КОГДА РАЗНОСТЬДАТ(ВКМ_ДниОтпускаСотрудников.ДатаОкончания, &amp;ДатаОкончания, ДЕНЬ) &gt; ВременнаяТаблица.КоличествоДней
					ТОГДА ВременнаяТаблица.КоличествоДней
				ИНАЧЕ РАЗНОСТЬДАТ(ВКМ_ДниОтпускаСотрудников.ДатаОкончания, &amp;ДатаОкончания, ДЕНЬ)
			КОНЕЦ
	КОНЕЦ</query>
	</dataSet>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>ДатаНачала</dcscor:parameter>
					<dcscor:value xsi:type="xs:dateTime">0001-01-01T00:00:00</dcscor:value>
					<dcsset:userSettingID>0f2260bf-665b-445b-9011-dbb6cbf0c7ff</dcsset:userSettingID>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>ДатаОкончания</dcscor:parameter>
					<dcscor:value xsi:type="xs:dateTime">0001-01-01T00:00:00</dcscor:value>
					<dcsset:userSettingID>b3119abd-3d6c-46c1-a30f-fe5baadcb0d2</dcsset:userSettingID>
				</dcscor:item>
			</dcsset:dataParameters>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>Сотрудник</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>КоличествоДнейПоПлану</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>КоличествоДнейОтгулено</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>